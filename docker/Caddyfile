{$PANEL_DOMAIN:localhost} {
  encode zstd gzip

  handle /api/* {
    reverse_proxy proxyhub-server:3000
  }

  handle /sub/* {
    reverse_proxy proxyhub-server:3000
  }

  handle {
    reverse_proxy proxyhub-web:80
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

# Docker runtime-test only: expose the synthetic performance fixture on a
# loopback-only virtual host so the host-network Xray can reach it without
# Docker gateway hairpin NAT. The upstream is absent outside runtime-test.
https://caddy, https://127.0.0.1 {
  tls internal
  log

  handle_path /network-perf-fixture/* {
    reverse_proxy network-perf-fixture:8080
  }

  respond 404
}
