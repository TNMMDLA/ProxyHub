{$PANEL_DOMAIN:localhost} {
  encode zstd gzip

  handle /api/* {
    reverse_proxy proxyhub-server:3000
  }

  handle /sub/* {
    reverse_proxy proxyhub-server:3000
  }

  handle {
    reverse_proxy proxyhub-web:80
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

# Docker runtime-test only: keep the synthetic performance fixture off the
# public panel host while still exercising HTTPS over the isolated Docker
# network. The upstream is absent outside the runtime-test profile.
https://caddy {
  tls internal

  handle_path /network-perf-fixture/* {
    reverse_proxy network-perf-fixture:8080
  }

  respond 404
}
