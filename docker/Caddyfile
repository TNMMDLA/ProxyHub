{$PANEL_DOMAIN:localhost} {
  encode zstd gzip

  handle /api/* {
    reverse_proxy proxyhub-server:3000
  }

  handle /sub/* {
    reverse_proxy proxyhub-server:3000
  }

  handle_path /network-perf-fixture/* {
    reverse_proxy network-perf-fixture:8080
  }

  handle {
    reverse_proxy proxyhub-web:80
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}
