generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                 String         @id @default(cuid())
  username           String         @unique
  passwordHash       String
  role               String         @default("ADMIN")
  totpEnabled        Boolean        @default(false)
  totpSecretEncrypted String?
  failedLoginCount   Int            @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           Session[]
  recoveryCodes      RecoveryCode[]
  apiTokens          ApiToken[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String
  userAgent String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  codeHash  String
  usedAt    DateTime?
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  permission String
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Server {
  id            String   @id @default(cuid())
  name          String
  hostname      String
  ip            String
  region        String   @default("Local")
  country       String   @default("")
  city          String   @default("")
  provider      String   @default("Self-hosted")
  agentVersion  String?
  xrayVersion   String?
  status        String   @default("UNKNOWN")
  cpuUsage      Float    @default(0)
  memoryUsage   Float    @default(0)
  diskUsage     Float    @default(0)
  networkRx     Float    @default(0)
  networkTx     Float    @default(0)
  lastHeartbeat DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  nodes         Node[]
  agent         Agent?
}

model Agent {
  id            String   @id @default(cuid())
  serverId      String   @unique
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  endpoint      String
  tokenHash     String
  version       String?
  status        String   @default("UNKNOWN")
  lastHeartbeat DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Node {
  id                          String           @id @default(cuid())
  serverId                    String
  server                      Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name                        String
  protocol                    String           @default("VLESS")
  transport                   String           @default("TCP")
  host                        String
  port                        Int
  uuid                        String           @unique
  flow                        String           @default("xtls-rprx-vision")
  realityPublicKey            String
  realityPrivateKeyEncrypted  String
  shortId                     String
  sni                         String
  dest                        String
  fingerprint                 String           @default("chrome")
  status                      String           @default("UNKNOWN")
  enabled                     Boolean          @default(true)
  lastCheckAt                 DateTime?
  latency                     Int?
  exitIp                      String?
  asn                         String?
  country                     String?
  region                      String?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  pools                       NodePoolMember[]
  performanceRuns             NetworkPerformanceRun[]
  userAccesses                UserAccess[]

  @@unique([serverId, port])
  @@index([status, enabled])
}

model UserGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                String            @id @default(cuid())
  name              String
  remark            String            @default("")
  groupId           String?
  group             UserGroup?        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  adminEnabled      Boolean           @default(true)
  expiresAt         DateTime?
  trafficLimitBytes BigInt?
  resetPolicy       String            @default("NEVER")
  resetDay          Int?
  lifecycleStatus   String            @default("ACTIVE")
  deletedAt         DateTime?
  lastTrafficAt     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  credential        UserCredential?
  accesses          UserAccess[]
  trafficUsage      UserTrafficUsage?

  @@index([groupId])
  @@index([adminEnabled, expiresAt])
  @@index([deletedAt, createdAt])
}

model UserCredential {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedClientId String
  createdAt         DateTime @default(now())
  rotatedAt         DateTime?
}

model UserAccess {
  id            String                  @id @default(cuid())
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId        String
  node          Node                    @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  enabled       Boolean                 @default(true)
  revokedAt     DateTime?
  statsIdentity String                  @unique
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  trafficUsage  UserAccessTrafficUsage?
  runtimeCounter UserTrafficRuntimeCounter?

  @@unique([userId, nodeId])
  @@index([nodeId, enabled])
  @@index([userId, enabled])
  @@index([revokedAt])
}

model UserTrafficUsage {
  userId                  String   @id
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCycleUplinkBytes BigInt   @default(0)
  currentCycleDownlinkBytes BigInt @default(0)
  lifetimeUplinkBytes     BigInt   @default(0)
  lifetimeDownlinkBytes   BigInt   @default(0)
  cycleStartedAt          DateTime @default(now())
  cycleEndsAt             DateTime?
  updatedAt               DateTime @updatedAt
}

model UserAccessTrafficUsage {
  userAccessId            String     @id
  userAccess              UserAccess @relation(fields: [userAccessId], references: [id], onDelete: Cascade)
  currentCycleUplinkBytes BigInt     @default(0)
  currentCycleDownlinkBytes BigInt   @default(0)
  lifetimeUplinkBytes     BigInt     @default(0)
  lifetimeDownlinkBytes   BigInt     @default(0)
  lastTrafficAt           DateTime?
  updatedAt               DateTime   @updatedAt
}

model UserTrafficRuntimeCounter {
  userAccessId      String     @id
  userAccess        UserAccess @relation(fields: [userAccessId], references: [id], onDelete: Cascade)
  uplinkBytes       BigInt     @default(0)
  downlinkBytes     BigInt     @default(0)
  observedAt        DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model NetworkPerformanceRun {
  id              String                           @id @default(cuid())
  nodeId          String
  node            Node                             @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  status          String                           @default("QUEUED")
  score           Int?
  summaryJson     String                           @default("{}")
  environmentJson String                           @default("{}")
  startedAt       DateTime                         @default(now())
  completedAt     DateTime?
  durationMs      Int?
  xrayVersion     String?
  proxyhubVersion String
  buildSha        String
  createdAt       DateTime                         @default(now())
  targetResults   NetworkPerformanceTargetResult[]

  @@index([nodeId, startedAt])
  @@index([status, startedAt])
}

model NetworkPerformanceTargetResult {
  id                    String                @id @default(cuid())
  runId                 String
  run                   NetworkPerformanceRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  targetId              String
  targetLabel           String
  success               Boolean
  errorCode             String?
  directMbps            Float?
  tunnelMbps            Float?
  efficiencyPercent     Float?
  latencyMedianMs       Float?
  latencyP95Ms          Float?
  jitterMs              Float?
  successfulRequests    Int                   @default(0)
  failedRequests        Int                   @default(0)
  directSamplesJson     String                @default("[]")
  tunnelSamplesJson     String                @default("[]")
  uploadStatus          String                @default("NOT_AVAILABLE")
  analysisCodesJson     String                @default("[]")
  createdAt             DateTime              @default(now())

  @@unique([runId, targetId])
  @@index([runId])
}

model NodePool {
  id          String           @id @default(cuid())
  name        String           @unique
  description String           @default("")
  region      String           @default("Global")
  strategy    String           @default("MANUAL")
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     NodePoolMember[]
  defaultPolicies Policy[]     @relation("PolicyDefaultNodePool")
  policyRules     PolicyRule[] @relation("PolicyRuleNodePool")
}

model NodePoolMember {
  nodeId     String
  node       Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodePoolId String
  nodePool   NodePool @relation(fields: [nodePoolId], references: [id], onDelete: Cascade)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())

  @@id([nodeId, nodePoolId])
  @@index([nodePoolId])
}

model Notification {
  id        String    @id @default(cuid())
  level     String    @default("INFO")
  title     String
  message   String
  eventType String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  severity  String
  ip        String?
  userAgent String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  action     String
  resource   String
  resourceId String?
  ip         String?
  result     String
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([resource, resourceId])
}

model SystemSetting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Policy {
  id                String         @id @default(cuid())
  name              String         @unique
  description       String         @default("")
  enabled           Boolean        @default(true)
  revision          Int            @default(1)
  defaultAction     String         @default("DIRECT")
  defaultNodePoolId String?
  defaultNodePool   NodePool?      @relation("PolicyDefaultNodePool", fields: [defaultNodePoolId], references: [id], onDelete: Restrict)
  rules             PolicyRule[]
  subscriptions     Subscription[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([enabled, updatedAt])
  @@index([defaultNodePoolId])
}

model PolicyRule {
  id          String    @id @default(cuid())
  policyId    String
  policy      Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  enabled     Boolean   @default(true)
  priority    Int
  matchType   String
  matchValue  String
  matchSourceType String @default("INLINE")
  ruleSetId   String?
  ruleSet     RuleSet?   @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  actionType  String
  nodePoolId  String?
  nodePool    NodePool? @relation("PolicyRuleNodePool", fields: [nodePoolId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([policyId, priority])
  @@index([nodePoolId])
  @@index([ruleSetId])
}

model RuleSet {
  id                    String         @id @default(cuid())
  name                  String         @unique
  description           String         @default("")
  enabled               Boolean        @default(true)
  sourceType            String
  format                String
  sourceUrl             String?
  updateIntervalMinutes Int?
  lastFetchAt           DateTime?
  lastSuccessAt         DateTime?
  nextUpdateAt          DateTime?
  status                String         @default("EMPTY")
  lastError             String?
  contentHash           String?
  ruleCount             Int            @default(0)
  revision              Int            @default(1)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  entries               RuleSetEntry[]
  cache                 RuleSetCache?
  policyRules           PolicyRule[]

  @@index([enabled, status])
  @@index([nextUpdateAt])
}

model RuleSetEntry {
  id        String   @id @default(cuid())
  ruleSetId String
  ruleSet   RuleSet  @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  type      String
  value     String
  enabled   Boolean  @default(true)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleSetId, order])
}

model RuleSetCache {
  ruleSetId         String   @id
  ruleSet           RuleSet  @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  normalizedContent String
  contentHash       String
  ruleCount         Int
  duplicateCount    Int      @default(0)
  warnings          String   @default("[]")
  sourceEtag        String?
  sourceLastModified String?
  fetchedAt         DateTime
  validatedAt       DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Subscription {
  id           String   @id @default(cuid())
  name         String   @unique
  enabled      Boolean  @default(true)
  policyId     String
  policy       Policy   @relation(fields: [policyId], references: [id], onDelete: Restrict)
  format       String
  tokenHash    String   @unique
  tokenPrefix  String
  expiresAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([policyId])
  @@index([enabled, expiresAt])
}
