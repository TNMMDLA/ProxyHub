{
  "name": "proxyhub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Modern proxy infrastructure management platform",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @proxyhub/server --filter @proxyhub/web dev",
    "release:generate-version": "node scripts/release/generate-version.mjs",
    "release:check-version": "node scripts/release/generate-version.mjs --check",
    "release:manifest": "node scripts/release/generate-manifest.mjs",
    "release:manifest:validate": "node scripts/release/validate-manifest.mjs",
    "build:packages": "pnpm release:generate-version && pnpm -r --filter @proxyhub/diagnostics-core --filter @proxyhub/network-performance-core --filter @proxyhub/policy-core --filter @proxyhub/rule-set-core --filter @proxyhub/shared --filter @proxyhub/xray-manager --if-present build",
    "build": "pnpm release:generate-version && pnpm -r --if-present build",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "lint": "pnpm build:packages && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "test:compat": "pnpm build:packages && vitest run packages/policy-core/src/golden.test.ts packages/policy-core/src/hardening.test.ts packages/xray-manager/src/index.test.ts",
    "compat:generate": "pnpm build:packages && tsx scripts/compat/generate-configs.ts",
    "compat:validate:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compat/validate-windows.ps1",
    "test:migration": "vitest run apps/server/src/migration.integration.test.ts",
    "test:rulesets": "pnpm build:packages && vitest run packages/rule-set-core/src apps/server/src/rule-set packages/policy-core/src/rule-set.test.ts",
    "test:subscriptions": "pnpm build:packages && vitest run apps/server/src/subscription-delivery.test.ts apps/server/src/app.integration.test.ts",
    "test:network-performance": "pnpm build:packages && vitest run packages/network-performance-core/src apps/agent/src/network-performance apps/server/src/network-performance",
    "test:i18n": "vitest run apps/web/src/i18n",
    "test:phase3": "pnpm build:packages && vitest run apps/web/src/i18n apps/server/src/subscription-delivery.test.ts apps/server/src/app.integration.test.ts",
    "test:runtime-packages": "node scripts/runtime/verify-workspace-packages.mjs",
    "test:manifest": "pnpm build:packages && vitest run scripts/release/manifest.test.ts apps/server/src/release",
    "test:ops": "vitest run scripts/ops",
    "test:backup": "vitest run scripts/ops -t backup",
    "test:update": "vitest run scripts/ops -t update",
    "test:rollback": "vitest run scripts/ops -t rollback",
    "test:security": "vitest run scripts/ops -t safety",
    "lint:shell": "shellcheck -x -P SCRIPTDIR --severity=warning scripts/ops/*.sh scripts/ops/lib/*.sh scripts/docker/*.sh scripts/compat/*.sh",
    "db:generate": "pnpm --filter @proxyhub/server db:generate",
    "db:migrate": "pnpm --filter @proxyhub/server db:migrate",
    "db:seed": "pnpm --filter @proxyhub/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
