# Public hostname used by Caddy. Use localhost for local evaluation.
PANEL_DOMAIN=localhost
WEB_ORIGIN=https://localhost

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
AGENT_TOKEN=replace-with-a-long-random-agent-token

SESSION_TTL_HOURS=24
DATABASE_URL=file:/app/data/proxyhub.db
TRUST_PROXY=true

# Remote Rule Set safety limits. Keep HTTP disabled in production.
RULE_SET_MAX_BYTES=5242880
RULE_SET_MAX_RULES=50000
RULE_SET_FETCH_TIMEOUT_MS=10000
RULE_SET_MAX_REDIRECTS=3
RULE_SET_ALLOW_HTTP=false

# Optional Agent health tuning. Docker Compose provides container-safe defaults.
XRAY_HEALTH_TIMEOUT_MS=12000
REALITY_COMPATIBILITY_TIMEOUT_MS=20000

# User traffic accounting. Xray metrics remain on the Docker-internal gateway.
PROXYHUB_TRAFFIC_ACCOUNTING_INTERVAL_MS=30000

# On-demand server-side Network Performance Test.
# Configure 1-5 HTTPS data endpoints that you have verified are suitable for automated testing.
# No public endpoint is assumed to remain permanently available, so the registry is empty by default.
# PROXYHUB_NETWORK_PERF_TARGETS_JSON=[{"id":"provider-a","label":"Provider A","smallRequestUrl":"https://replace.example/small","downloadUrl":"https://replace.example/download","enabled":true,"maxDownloadBytes":16777216}]
PROXYHUB_NETWORK_PERF_TIMEOUT_MS=120000
PROXYHUB_NETWORK_PERF_TARGET_TIMEOUT_MS=20000
PROXYHUB_NETWORK_PERF_NODE_HOST=host.docker.internal
PROXYHUB_NETWORK_PERF_TEST_MODE=false

# Read-only Diagnostics Center. Limits are bounded for low-resource VPS deployments.
PROXYHUB_DIAGNOSTICS_ENABLED=true
PROXYHUB_DIAGNOSTICS_CACHE_TTL_MS=10000
PROXYHUB_DIAGNOSTICS_DEEP_TIMEOUT_MS=30000
PROXYHUB_DIAGNOSTICS_MAX_HISTORY=20
PROXYHUB_DIAGNOSTICS_MAX_BACKUPS=50

# Release image mode. Operations load digest-pinned values from a release manifest.
# Do not use floating tags such as latest. These placeholders are intentionally not secrets.
PROXYHUB_WEB_IMAGE=ghcr.io/tnmmdla/proxyhub-web@sha256:replace-with-release-digest
PROXYHUB_SERVER_IMAGE=ghcr.io/tnmmdla/proxyhub-server@sha256:replace-with-release-digest
PROXYHUB_AGENT_IMAGE=ghcr.io/tnmmdla/proxyhub-agent@sha256:replace-with-release-digest
PROXYHUB_XRAY_IMAGE=ghcr.io/tnmmdla/proxyhub-xray@sha256:replace-with-release-digest

# Optional host operation paths. Defaults remain inside this checkout.
# PROXYHUB_STATE_DIR=/opt/proxyhub/state
# PROXYHUB_BACKUP_DIR=/opt/proxyhub/backups
